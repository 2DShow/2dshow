---
import '../styles/global.css';
import { site } from '../data/site.js';
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.artwork, Astro.site)} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 font-sans text-stone-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-3">К содержимому</a>
    <header class="bg-brand text-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-6 sm:px-8">
        <a href="/" class="text-xl font-semibold tracking-tight"><span class="text-brand-accent">2D</span> Show</a>
        <nav aria-label="Навигация" class="flex gap-6 text-sm">
          <a href="/#episodes" class="transition-colors hover:text-brand-accent">Эпизоды</a>
          <a href="/feed.xml" class="transition-colors hover:text-brand-accent">RSS</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="mx-auto flex max-w-5xl flex-col gap-4 border-t border-stone-200 px-6 py-8 text-sm text-stone-600 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>Ведущие: <a href="https://dan.kim" class="text-brand underline-offset-4 hover:underline">Даня Ким</a> и <a href="https://twitter.com/danshevluk" class="text-brand underline-offset-4 hover:underline">Данила Шевлюк</a></p>
      <a href="https://twitter.com/2dshowfm" class="text-brand underline-offset-4 hover:underline">@2dshowfm</a>
    </footer>
  </body>
</html>

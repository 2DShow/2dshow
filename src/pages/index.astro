---
import Layout from '../layouts/Layout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { site } from '../data/site.js';
import { getEpisodes, episodePath, formatDate } from '../lib/episodes.js';
const episodes = await getEpisodes();
---

<Layout>
  <main id="main">
    <section aria-labelledby="show-title" class="bg-brand text-white">
      <div class="mx-auto max-w-5xl px-6 sm:px-8">
        <div class="grid items-center gap-8 border-t border-white/15 pt-10 pb-12 sm:grid-cols-[1fr_auto] sm:py-12 lg:gap-16 lg:py-16">
          <div>
            <h1 id="show-title" class="text-6xl leading-none font-semibold tracking-tight lg:text-8xl"><span class="text-brand-accent">2D</span> Show</h1>
            <p class="mt-6 max-w-md text-lg leading-relaxed text-white/80 sm:text-xl">{site.description}</p>
          </div>
          <img src={site.artwork} alt="Обложка подкаста 2D Show" width="1500" height="1500" fetchpriority="high" class="size-44 rounded-xl shadow-xl shadow-black/20 ring-1 ring-white/15 sm:size-52 lg:size-72" />
        </div>
      </div>
    </section>

    <section id="episodes" aria-labelledby="episodes-title" class="mx-auto max-w-5xl scroll-mt-8 px-6 pt-8 pb-12 sm:px-8 sm:pt-10">
      <h2 id="episodes-title" class="border-b border-stone-200 pb-4 text-2xl font-semibold tracking-tight text-brand">Эпизоды</h2>
      <ol class="divide-y divide-stone-200">
        {episodes.map((episode) => (
          <li class="grid grid-cols-[1.5rem_1fr] items-start gap-x-4 gap-y-4 py-6 md:grid-cols-[2.5rem_1fr_16rem] md:gap-6">
            <span class="pt-1 text-sm text-stone-500 tabular-nums" aria-label={`Эпизод ${episode.data.number}`}>{episode.data.number}</span>
            <div>
              <h3 class="text-xl leading-snug font-semibold tracking-tight"><a href={episodePath(episode)} class="text-brand underline-offset-4 hover:underline">{episode.data.title}</a></h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{episode.data.summary}</p>
              <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500"><time datetime={episode.data.date.toISOString()}>{formatDate(episode.data.date)}</time><span>{episode.data.duration}</span></p>
            </div>
            <div class="col-start-2 w-full max-w-sm md:col-start-auto md:pt-1"><AudioPlayer episode={episode} /></div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { site } from '../data/site.js';
import { getEpisodes, episodePath, formatDate } from '../lib/episodes.js';
const episodes = await getEpisodes();
---

<Layout>
  <main id="main" class="mx-auto max-w-5xl px-6 sm:px-8">
    <section aria-labelledby="show-title" class="grid items-center gap-8 pt-12 pb-14 sm:grid-cols-[auto_1fr] sm:gap-12 sm:py-16">
      <img src={site.artwork} alt="Обложка подкаста 2D Show" width="1500" height="1500" fetchpriority="high" class="size-44 rounded-md sm:size-56" />
      <div>
        <h1 id="show-title" class="text-5xl font-semibold tracking-tight text-brand sm:text-6xl">2D Show</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-stone-700 sm:text-xl">{site.description}</p>
      </div>
    </section>

    <section id="episodes" aria-labelledby="episodes-title" class="scroll-mt-8 pb-12">
      <h2 id="episodes-title" class="border-b border-stone-200 pb-5 text-2xl font-semibold tracking-tight text-brand">Эпизоды</h2>
      <ol class="divide-y divide-stone-200">
        {episodes.map((episode) => (
          <li class="grid grid-cols-[1.5rem_1fr] items-start gap-x-4 gap-y-5 py-8 md:grid-cols-[2.5rem_1fr_16rem] md:gap-6">
            <span class="pt-1 text-sm text-stone-500 tabular-nums" aria-label={`Эпизод ${episode.data.number}`}>{episode.data.number}</span>
            <div>
              <h3 class="text-xl leading-snug font-semibold tracking-tight"><a href={episodePath(episode)} class="text-brand underline-offset-4 hover:underline">{episode.data.title}</a></h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-600">{episode.data.summary}</p>
              <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500"><time datetime={episode.data.date.toISOString()}>{formatDate(episode.data.date)}</time><span>{episode.data.duration}</span></p>
            </div>
            <div class="col-start-2 w-full max-w-sm md:col-start-auto md:pt-1"><AudioPlayer episode={episode} /></div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>
